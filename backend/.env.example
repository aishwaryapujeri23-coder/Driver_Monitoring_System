# Copy this file to .env before running the app.

APP_ENV=development
DEBUG=true

DATABASE_URL=sqlite:///./driver_monitoring.db

# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

YOLO_MODEL_PATH=models/yolo/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45

EAR_THRESHOLD=0.21
EYE_CLOSED_DURATION=1.5
EYE_CLOSED_CRITICAL_DURATION=2.5
BLINK_MIN_DURATION=0.08
BLINK_MAX_DURATION=0.4

YAWN_THRESHOLD=0.6
YAWN_DURATION=1.2

HEAD_YAW_THRESHOLD=25.0
HEAD_PITCH_THRESHOLD=20.0
DISTRACTION_DURATION=2.0
FACE_ABSENT_DURATION=2.0

RISK_WEIGHT_DROWSINESS=0.6
RISK_WEIGHT_DISTRACTION=0.4

ALERT_COOLDOWN=5.0

PROCESSING_INTERVAL_MS=150
PHONE_CHECK_INTERVAL_MS=3000
MAX_FRAME_WIDTH=480
